DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmaiq
SECRET_KEY=super-secret-key-change-me
MODEL_PATH=ml_engine/saved_models/
OPENAI_API_KEY=your_openai_api_key_here
ENVIRONMENT=development
API_VERSION=v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional language model for the AI assistant: any OpenAI-compatible API.
# Leave unset to use OpenAI with OPENAI_API_KEY. Examples:
#   Ollama (free, local):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2
#   Groq (free tier):      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_API_KEY=gsk_...   LLM_MODEL=llama-3.1-8b-instant
#   Google Gemini (free):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_API_KEY=AIza...   LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=60
